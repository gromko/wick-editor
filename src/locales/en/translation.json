  "welcomeMessage": {
    "title": "About Wick Editor",
    "paragraph1": "Wick Editor is a free and open-source tool for creating games, animations, and everything in between. Designed to be accessible and easy to use, it provides a flexible environment for creating multimedia projects on the web.",
    "paragraph2": "It combines animation tools with a coding environment, drawing inspiration from projects such as HyperCard and Scratch. The editor was created in response to the growing need for an accessible multimedia creation tool for the modern web.",
    "createdBy": "The project was created and is led by Zach Rispoli and Luca Damasco."
    }
